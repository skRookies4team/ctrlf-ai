# ctrlf-ai-gateway 환경변수 설정 예시
# 이 파일을 복사하여 .env 파일을 생성하세요: cp .env.example .env

# =============================================================================
# 앱 기본 설정
# =============================================================================
APP_NAME=ctrlf-ai-gateway
APP_ENV=local  # local / dev / prod / docker
APP_VERSION=0.1.0
LOG_LEVEL=INFO  # DEBUG / INFO / WARNING / ERROR
CORS_ORIGINS=*  # 개발: *, 프로덕션: https://your-domain.com

# =============================================================================
# Elasticsearch 설정
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=ctrlf-chat-log-*

# =============================================================================
# 서비스 URL 설정
# =============================================================================
# LLM 서비스 URL (직접 지정 또는 *_REAL 사용)
LLM_BASE_URL=http://localhost:8001

# Real 모드 URL (LLM_BASE_URL 미설정 시 사용)
RAGFLOW_BASE_URL_REAL=
LLM_BASE_URL_REAL=
BACKEND_BASE_URL_REAL=

# =============================================================================
# RAGFlow 설정
# =============================================================================
RAGFLOW_API_KEY=
RAGFLOW_EMBEDDING_MODEL=text-embedding-3-large@OpenAI

# =============================================================================
# LLM 모델 설정
# =============================================================================
# 채팅/FAQ용 LLM 모델
LLM_MODEL_NAME=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct

# 스크립트 생성용 LLM 모델 (미설정 시 LLM_MODEL_NAME 사용)
SCRIPT_LLM_MODEL=

# =============================================================================
# OpenAI 설정 (임베딩 + LLM)
# =============================================================================
OPENAI_API_KEY=

# OpenAI 임베딩 설정
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=3072

# OpenAI LLM 설정 (관리자 대시보드에서 OpenAI 선택 시 사용)
OPENAI_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# =============================================================================
# Backend 연동 설정
# =============================================================================
BACKEND_BASE_URL=http://localhost:8080

# =============================================================================
# PII 마스킹 설정
# =============================================================================
PII_ENABLED=false

# =============================================================================
# Milvus Vector Database 설정
# =============================================================================
MILVUS_ENABLED=true
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=ragflow_chunks_openai
MILVUS_TOP_K=5
MILVUS_SEARCH_PARAMS={"metric_type":"L2","params":{"nprobe":10}}

# =============================================================================
# 임베딩 설정
# =============================================================================
EMBEDDING_BASE_URL=http://localhost:1234
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=3072
EMBEDDING_CONTRACT_STRICT=true

# =============================================================================
# RAG 검색 설정
# =============================================================================
RETRIEVAL_BACKEND=milvus  # ragflow / milvus
RAG_DATASET_FILTER_ENABLED=true
RAG_EDUCATION_DATASET_IDS=직무교육,장애인인식개선교육,직장내괴롭힘교육,직장내성희롱교육,정보보안교육,사내규정

# 부서 필터 활성화 여부 (Milvus 스키마에 department 컬럼 추가 후 true로 변경)
# true: department 컬럼으로 부서별 교육영상 필터링 (본인 부서 + 전체 부서)
# false: 부서 필터 비활성화 (모든 교육영상 조회)
RAG_DEPARTMENT_FILTER_ENABLED=false

# 부서 범위 목록:
# - 전체 부서, 총무팀, 기획팀, 마케팅팀, 인사팀, 재무팀, 개발팀, 영업팀, 법무팀

# =============================================================================
# Router 설정
# =============================================================================
ROUTER_ORCHESTRATOR_ENABLED=false

# =============================================================================
# 개인화 모드
# =============================================================================
# auto: 백엔드 시도 후 실패시 fallback
# real: 백엔드 필수
# mock: mock 데이터 사용
PERSONALIZATION_MODE=auto

# =============================================================================
# Quality Gate 설정 (RAG 품질 제어)
# =============================================================================
RAG_QUALITY_HARD_DROP_ENABLED=true
RAG_QUALITY_DISTANCE_GATE_ENABLED=true
RAG_QUALITY_L2_WARN=1.4
RAG_QUALITY_L2_REJECT=1.6

# =============================================================================
# HeyGen 영상 생성 설정
# =============================================================================
# 렌더 엔진: ffmpeg / heygen / heygen_pip
VIDEO_RENDER_ENGINE=heygen_pip

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_BG_TYPE=color
HEYGEN_BG_VALUE=#FFFFFF
HEYGEN_VIDEO_WIDTH=1280
HEYGEN_VIDEO_HEIGHT=720

# =============================================================================
# Storage/S3 설정 (영상 업로드)
# =============================================================================
# 저장소 타입: local / s3 / minio / backend_presigned
STORAGE_PROVIDER=s3

AWS_S3_BUCKET=ctrl-s3
AWS_S3_REGION=ap-northeast-2
AWS_PROFILE=

# =============================================================================
# FAQ 자동 생성 설정
# =============================================================================
FAQ_DOMAIN=POLICY
FAQ_INTENT=POLICY_QA
FAQ_LOG_FETCH_LIMIT=500
FAQ_LOOKBACK=now-7d

# =============================================================================
# 인덱싱 파이프라인 설정
# =============================================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
INDEX_RETRY_MAX_ATTEMPTS=3
INDEX_RETRY_BACKOFF_SECONDS=1,2,4
FILE_DOWNLOAD_TIMEOUT_SEC=60.0
FILE_MAX_SIZE_MB=50
SUPPORTED_FILE_EXTENSIONS=.pdf,.txt,.docx,.doc,.hwp

# =============================================================================
# 내부 API 인증 토큰
# =============================================================================
# Backend -> AI 요청 시 사용 (예: /internal/ai/rag-documents/ingest)
BACKEND_INTERNAL_TOKEN=

# RAGFlow -> AI 콜백 요청 시 사용
AI_CALLBACK_TOKEN=

# AI -> Backend 스토리지 API 요청 시 사용 (Presigned URL 발급 등)
BACKEND_SERVICE_TOKEN=

# AI -> Backend 일반 API 요청 시 사용 (Authorization: Bearer)
BACKEND_API_TOKEN=
